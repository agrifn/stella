      "examples": [
        "starmap",
        "open map",
        "show map",
        "navigation map"
      ]
    },
    "camera_cycle": {
      "key": "f4",
      "confirm_required": false,
      "description": "Cycle camera view (1st/3rd person)",
      "examples": [
        "cycle camera",

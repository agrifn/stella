{
  "_comment": "Curated Star Citizen Alpha 4.0 commands (from scfocus.org defaults). LLM classifies intent; server resolves key. Keys use pydirectinput names. Edit to match your personal SC bindings. Manage via the command-manager GUI.",
  "keybinds": {
    "decouple_toggle": {
      "key": "c",
      "confirm_required": false,
      "description": "Toggle decoupled/coupled flight mode",
      "examples": [
        "decouple",
        "coupled mode",
        "decoupled mode",
        "toggle decouple"
      ]
    },
    "cruise_control_toggle": {
      "key": "altleft+c",
      "confirm_required": false,
      "description": "Toggle cruise control",
      "examples": [
        "cruise control",
        "toggle cruise",
        "cruise on",
        "cruise off"
      ]
    },
    "vtol_toggle": {
      "key": "k",
      "confirm_required": false,
      "description": "Toggle VTOL mode",
      "examples": [
        "vtol",
        "vtol mode",
        "hover mode",
        "toggle vtol"
      ]
    },
    "landing_gear": {
      "key": "n",
      "confirm_required": false,
      "description": "Toggle landing gear",
      "examples": [
        "landing gear",
        "gear up",
        "gear down",
        "toggle gear"
      ]
    },
    "request_landing": {
      "key": "altleft+n",
      "confirm_required": false,
      "description": "Request landing permission from ATC",
      "examples": [
        "request landing",
        "request permission to land",
        "hail tower",
        "ask for landing"
      ]
    },
    "nav_mode": {
      "key": "b",
      "confirm_required": false,
      "hold": true,
      "description": "Enter quantum/NAV mode (hold and release B)",
      "examples": [
        "nav mode",
        "quantum mode",
        "navigation mode",
        "open quantum"
      ]
    },
    "power_toggle_all": {
      "key": "u",
      "confirm_required": false,
      "description": "Toggle all power on/off",
      "examples": [
        "power on",
        "power off",
        "all power",
        "toggle power"
      ]
    },
    "systems_ready": {
      "key": "altright+r",
      "confirm_required": false,
      "description": "Flight/systems ready toggle",
      "examples": [
        "systems ready",
        "flight ready",
        "preflight",
        "ready up"
      ]
    },
    "weapons_power_toggle": {
      "key": "p",
      "confirm_required": false,
      "description": "Toggle weapons power on/off",
      "examples": [
        "weapons on",
        "weapons off",
        "arm weapons"
      ]
    },
    "shields_power_toggle": {
      "key": "o",
      "confirm_required": false,
      "description": "Toggle shields power on/off",
      "examples": [
        "shields on",
        "shields off",
        "toggle shields"
      ]
    },
    "thrusters_power_toggle": {
      "key": "i",
      "confirm_required": false,
      "description": "Toggle thruster power on/off",
      "examples": [
        "engines on",
        "engines off",
        "toggle engines"
      ]
    },
    "reset_power": {
      "key": "f8",
      "confirm_required": false,
      "description": "Reset power distribution to default",
      "examples": [
        "reset power",
        "balance power",
        "default power",
        "equalize power"
      ]
    },
    "weapons_power_max": {
      "key": "f5",
      "confirm_required": false,
      "hold": true,
      "hold_duration": 0.25,
      "description": "Set weapons power to maximum",
      "examples": [
        "max guns",
        "weapons hot",
        "max weapon power",
        "weapons to max",
        "full power to weapons",
        "all power to weapons"
      ]
    },
    "engines_power_max": {
      "key": "f6",
      "confirm_required": false,
      "hold": true,
      "hold_duration": 0.25,
      "description": "Set engines power to maximum",
      "examples": [

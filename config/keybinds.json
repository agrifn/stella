    "engines_power_max": {
      "key": "f6",
      "confirm_required": false,
      "description": "Set engines power to maximum",
      "hold": true,
      "examples": [
        "max engine power",
        "full power to engines",
        "all power to engines",
        "engines to max"
      ]
    },
    "shields_power_max": {
      "key": "f7",
      "confirm_required": false,
      "description": "Set shields power to maximum",
      "hold": true,
      "examples": [
        "max shield power",
        "full power to shields",
        "all power to shields",
        "shields to max"
      ]
    },
    "unlock_target": {
      "key": "altleft+t",
      "confirm_required": false,
      "description": "Unlock current target",
      "examples": [
        "unlock target",
        "clear target",
        "release target",
        "drop target"
      ]
    },
    "gimbal_cycle": {
      "key": "g",
      "confirm_required": false,
      "description": "Cycle gimbal assist / standard / locked modes",
      "hold": true,
      "examples": [
        "cycle gimbal",

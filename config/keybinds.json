{
  "_comment": "Curated Star Citizen Alpha 4.0 commands (from scfocus.org defaults). LLM classifies intent; server resolves key. Keys use pydirectinput names. Edit to match your personal SC bindings. Manage via the command-manager GUI.",
  "keybinds": {
    "decouple_toggle": {
      "key": "c",
      "confirm_required": false,
      "description": "Toggle decoupled/coupled flight mode",
      "hold": true,
      "examples": [
        "decouple",
        "coupled mode",
        "decoupled mode",
        "toggle decouple"
      ]
    },
    "spacebrake": {
      "key": "x",
      "confirm_required": false,
      "description": "Full stop / spacebrake",
      "examples": [
        "full stop",
        "brake",
        "spacebrake",
        "all stop"
      ]
    },
    "boost": {
      "key": "shiftleft",
      "confirm_required": false,
      "description": "Afterburner / boost",
      "hold": true,
      "examples": [
        "boost",
        "afterburner",
        "punch it",
        "full burn"
      ]
    },
    "cruise_control_toggle": {
      "key": "altleft+c",
      "confirm_required": false,
      "description": "Toggle cruise control",
      "examples": [
        "cruise control",
        "toggle cruise",
        "cruise on",
        "cruise off"
      ]
    },
    "vtol_toggle": {
      "key": "k",
      "confirm_required": false,
      "description": "Toggle VTOL mode",
      "examples": [
        "vtol",
        "vtol mode",
        "hover mode",
        "toggle vtol"
      ]
    },
    "throttle_increase_max": {
      "key": "f10+f10",
      "confirm_required": false,
      "description": "Throttle to maximum (double tap)",
      "examples": [
        "full throttle",
        "max throttle",
        "throttle up max",
        "all ahead full"
      ]
    },
    "throttle_decrease_min": {
      "key": "f9+f9",
      "confirm_required": false,
      "description": "Throttle to minimum (double tap)",
      "examples": [
        "kill throttle",
        "zero throttle",
        "throttle down",
        "idle engines"
      ]
    },
    "landing_gear": {
      "key": "n",
      "confirm_required": false,
      "description": "Toggle landing gear",
      "examples": [
        "landing gear",
        "gear up",
        "gear down",
        "toggle gear"
      ]
    },
    "autoland": {
      "key": "n",
      "confirm_required": false,
      "description": "Autoland",
      "hold": true,
      "examples": [
        "autoland",
        "auto land",
        "automatic landing",
        "land automatically"
      ]
    },
    "request_landing": {
      "key": "altleft+n",
      "confirm_required": false,
      "description": "Request landing permission from ATC",
      "examples": [
        "request landing",
        "request permission to land",
        "hail tower",
        "ask for landing"
      ]
    },
    "nav_mode": {
      "key": "b",
      "confirm_required": false,
      "description": "Enter quantum/NAV mode (hold and release B)",
      "hold": true,
      "examples": [
        "nav mode",
        "quantum mode",
        "navigation mode",
        "open quantum"
      ]
    },
    "power_toggle_all": {
      "key": "u",
      "confirm_required": false,
      "description": "Toggle all power on/off",
      "examples": [
        "power on",
        "power off",
        "all power",
        "toggle power"
      ]
    },
    "systems_ready": {
      "key": "altright+r",
      "confirm_required": false,
      "description": "Flight/systems ready toggle",
      "examples": [
        "systems ready",
        "flight ready",
        "preflight",
        "ready up"
      ]
    },
    "weapons_power_toggle": {
      "key": "p",
      "confirm_required": false,
      "description": "Toggle weapons power on/off",
      "examples": [
        "weapons power",
        "weapons on",
        "weapons off",
        "arm weapons"
      ]
    },
    "shields_power_toggle": {
      "key": "o",
      "confirm_required": false,
      "description": "Toggle shields power on/off",
      "examples": [
        "shields power",
        "shields on",
        "shields off",
        "toggle shields"
      ]
    },
    "thrusters_power_toggle": {
      "key": "i",
      "confirm_required": false,
      "description": "Toggle thruster power on/off",
      "examples": [
        "thrusters power",
        "thrusters on",
        "thrusters off",
        "toggle thrusters"
      ]

    "shields_power_max": {
      "key": "f7",
      "confirm_required": false,
      "hold": true,
      "hold_duration": 0.25,
      "description": "Set shields power to maximum",
      "examples": [
        "max shields",
        "brace",
        "max shield power",
        "shields to max",
        "full power to shields",
        "all power to shields"
      ]
    },
    "unlock_target": {
      "key": "altleft+t",
      "confirm_required": false,

{
  "_comment": "Global settings shared conceptually by client and server. The server reads the 'server', 'tts', and 'classifier' sections; the client reads 'server_url', hotkeys, and mode.",
  "server": {
    "host": "0.0.0.0",
    "port": 8420
  },
  "server_url": "http://127.0.0.1:8420",
  "tts": {
    "enabled": true,
    "voice": "en_GB-jenny_dioco-medium",
    "sample_rate": 22050
  },
  "classifier": {
    "model": "minishlab/potion-base-32M",
    "reject_threshold": 0.45,
    "clarify_threshold": 0.55
  },
  "client": {
    "ptt_key": "right ctrl",
    "mode_toggle_key": "ctrl+alt+m",
    "samplerate": 16000,
    "input_device": null,
    "output_device": null,
    "default_mode": "COMMAND",
    "whisper_model": "large-v3-turbo",
    "whisper_device": "cuda",
    "whisper_compute_type": "float16",
    "execute_keys": true,
    "hold_duration": 1.5,
    "chat_open_key": "",
    "chat_send_key": "enter",
    "chat_open_delay": 0.25,
    "min_speech_seconds": 0.3,
    "min_speech_rms": 0.0012,
    "follow_up_window": 1.2,
    "start_asleep": false,
    "wake_key": "ctrl+alt+s",
    "auto_sleep_enabled": false,
    "auto_sleep_seconds": 300,
    "wake_word_enabled": false,
    "wake_word_model": "",
    "wake_word_threshold": 0.5,
    "overlay_corner": "bottom-right",
    "overlay_opacity": 0.85,
    "overlay_margin": 24,
    "overlay_scale": 0.8,
    "overlay_width": 300,
    "overlay_auto_hide": true,
    "overlay_hide_seconds": 4.0
  }
}

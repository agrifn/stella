# Copy to .env and edit. Controls which LLM the STELLA backend uses.

# --- Default: local Ollama container (private, no API key, runs on the GPU) ---
STELLA_LLM_PROVIDER=ollama
STELLA_LLM_MODEL=llama3.2:3b

# --- OpenAI-compatible (OpenAI, OpenRouter, Groq, LM Studio, vLLM, ...) ---
# STELLA_LLM_PROVIDER=openai
# STELLA_LLM_MODEL=gpt-4o-mini
# STELLA_LLM_BASE_URL=https://api.openai.com/v1
# STELLA_LLM_API_KEY=sk-...

# --- Anthropic (Claude) ---
# STELLA_LLM_PROVIDER=anthropic
# STELLA_LLM_MODEL=claude-3-5-haiku-latest
# STELLA_LLM_API_KEY=sk-ant-...

# --- UEX Corp API (optional): "where to buy / how much" for items & weapons ---
# Free token from https://uexcorp.space/api/apps . Enables item buy-location +
# price lookups in the knowledge feature. Leave unset to disable that sub-feature.
# STELLA_UEX_TOKEN=your_uex_token_here

# --- TTS engine (default: piper, self-contained in the image) ---
# Set to "chatterbox" to use a host-side Chatterbox TTS service (e.g. a custom
# voice) reachable at STELLA_CHATTERBOX_URL. Leave as piper for a clean install.
# STELLA_TTS_ENGINE=piper
# STELLA_CHATTERBOX_URL=http://host.docker.internal:8123

# --- Optional API token (defense in depth on a shared network) ---
# When set, every server route except /health requires 'Authorization: Bearer <token>'.
# The client sends it automatically when its own config has the same value. Unset =
# open (fine for a single-PC loopback setup). Use a long random string.
# STELLA_API_TOKEN=change_me_to_a_long_random_string

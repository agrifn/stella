# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/

# Secrets and local runtime state (never commit API keys)
.env
# Local voices dir (downloaded .onnx voices + the active.txt marker) when the
# server runs outside Docker; in the container these live in a named volume.
server/voices/

# Model + audio artifacts (downloaded at runtime / generated)
*.onnx
*.onnx.json
sample_*.wav

# Chatterbox voice service: never commit cloned voices / reference audio / weights.
# Only the code, docs, and templates under voice/ are tracked.
voice/*.wav
voice/wav/
voice/checkpoints/
voice/ckpts*/
voice/*.pt
voice/*.safetensors
voice/venv/
voice/.venv/

# OS / editor cruft
Thumbs.db
.DS_Store
.vscode/
.idea/
